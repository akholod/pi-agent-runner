{
  "name": "pi-agent-runner",
  "version": "0.7.0",
  "description": "Run child agents from a Pi extension: model, tools, permissions, timeouts and a live view, solved once",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "subagent",
    "agent",
    "runner"
  ],
  "homepage": "https://github.com/akholod/pi-agent-runner#readme",
  "bugs": {
    "url": "https://github.com/akholod/pi-agent-runner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akholod/pi-agent-runner.git"
  },
  "license": "MIT",
  "author": "akholod",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "lint": "eslint . && prettier --check \"**/*.ts\" \"**/*.json\" \"**/*.md\"",
    "fix": "eslint . --fix && prettier --write \"**/*.ts\" \"**/*.json\" \"**/*.md\"",
    "test:live": "RUNNER_LIVE=1 node --experimental-strip-types --test --test-concurrency=1 test/live.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm run typecheck && npm run lint && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-metarhia": "^9.2.1",
    "prettier": "^3.0.0",
    "typebox": "^1.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
